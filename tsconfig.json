{
	"extends": "@stefanprobst/tsconfig",
	"compilerOptions": {
		"baseUrl": ".",
		"exactOptionalPropertyTypes": false,
		"paths": {
			"@/*": ["./src/*"],
			"~/*": ["./*"]
		},
		"plugins": [{ "name": "next" }],
		"strictNullChecks": true
	},
	"include": ["**/*.ts", "**/*.tsx", "*.config.mjs", "*.config.cjs", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
